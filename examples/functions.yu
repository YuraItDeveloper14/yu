# Recursion and closures, written with English keywords
function factorial(n):
    if n <= 1:
        return 1
    return n * factorial(n - 1)

say("10! =", factorial(10))

function counter():
    count = 0
    function next():
        count = count + 1
        return count
    return next

tick = counter()
tick()
say("ticks:", tick())
